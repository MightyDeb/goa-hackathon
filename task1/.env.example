# Both are OPTIONAL for local development.
# Without them the app still runs end to end: fallback-share images are written
# to ./.share-store and served from /api/card/[id].

# Vercel Blob — required in production so /share/[id] images survive across
# serverless invocations. Create a Blob store in the Vercel dashboard.
BLOB_READ_WRITE_TOKEN=

# Guards /api/cleanup. Vercel Cron sends this automatically as a Bearer token.
# Leave unset locally to call the endpoint without auth.
CRON_SECRET=
